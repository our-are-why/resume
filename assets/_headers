# Response headers, which Cloudflare reads from this file when it deploys the
# site. Everything not listed here keeps Cloudflare's default, which has
# browsers check for changes on each visit. On resume.our.are.why.soy that
# relies on a Cache Rule in the why.soy zone set to "Respect origin TTL";
# without it the zone's Browser Cache TTL stretches this to 4 hours.

# The fonts never change, so browsers can keep them for a year without
# checking back.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Every response: browsers mustn't guess file types, and links out send only
# the site's address, not the page's.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
